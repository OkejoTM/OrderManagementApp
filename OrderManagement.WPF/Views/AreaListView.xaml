<UserControl x:Class="OrderManagement.WPF.Views.AreaListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OrderManagement.WPF.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:PaymentTypeConverter x:Key="PaymentTypeConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Районы" FontSize="24" FontWeight="Bold"
                   Foreground="#1E293B" Margin="0,0,0,16"/>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Поиск адреса по всей базе:"
                       VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#475569"/>
            <TextBox Grid.Column="1"
                     Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
            <Button Grid.Column="2" Content="✕ Очистить"
                    Command="{Binding ClearSearchCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0"
                    Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

        <!-- Toolbar (только для режима списка районов) -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <WrapPanel.Style>
                <Style TargetType="WrapPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSearchMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </WrapPanel.Style>
            <Button Content="＋ Добавить" Command="{Binding AddCommand}"/>
            <Button Content="✎ Редактировать" Command="{Binding EditCommand}"/>
            <Button Content="✕ Удалить" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
            <Button Content="📋 Адреса" Command="{Binding OpenAddressesCommand}"/>
            <Button Content="⟳ Обновить" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButton}"/>
        </WrapPanel>

        <!-- DataGrid: районы -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Areas}"
                  SelectedItem="{Binding SelectedArea}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False">
            <DataGrid.Style>
                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSearchMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenAddressesCommand}"/>
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- DataGrid: глобальный поиск адресов -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding SearchResults}"
                  SelectedItem="{Binding SelectedSearchResult}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick"
                              Command="{Binding OpenSearchResultCommand}"
                              CommandParameter="{Binding SelectedSearchResult}"/>
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Район" Binding="{Binding AreaName}" Width="180"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding AddressName}" Width="220"/>
                <DataGridTextColumn Header="Посл. дата" Binding="{Binding LastOrder.PumpingDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                <DataGridTextColumn Header="Кубы" Binding="{Binding LastOrder.CubeAmount}" Width="80"/>
                <DataGridTextColumn Header="Оплата" Binding="{Binding LastOrder.PaymentType, Converter={StaticResource PaymentTypeConverter}}" Width="110"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding LastOrder.Price, StringFormat=N2}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Пагинация поиска -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Visibility="{Binding IsSearchMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button Content="← Назад" Command="{Binding PrevSearchPageCommand}" Style="{StaticResource SecondaryButton}"/>
            <TextBlock VerticalAlignment="Center" Margin="12,0" Foreground="#475569">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Стр. {0} из {1} (всего: {2})">
                        <Binding Path="SearchPage"/>
                        <Binding Path="SearchTotalPages"/>
                        <Binding Path="SearchTotalCount"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <Button Content="Вперёд →" Command="{Binding NextSearchPageCommand}" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</UserControl>